# Banco do sistema (SQL Server, database próprio, leitura e escrita)
SISTEMA_DB_URL=mssql+pyodbc://usuario:senha@servidor/InteligenciaComercial?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Rodopar (SQL Server, usuário SOMENTE LEITURA, apenas nas views liberadas pelo TI)
RODOPAR_DB_URL=mssql+pyodbc://usuario_ro:senha@servidor/Rodopar?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# View de CT-e e colunas (ajustar conforme a view real)
RODOPAR_VIEW_CTE=vw_cte
RODOPAR_COLUNA_CLIENTE=PAGDOC
RODOPAR_COLUNA_DATA=DATDOC
RODOPAR_COLUNA_PESO=PESO
RODOPAR_COLUNA_FRETE=TOTFRE
RODOPAR_COLUNA_SITUACAO=SITUAC
# Situações válidas de CT-e separadas por vírgula (vazio = não filtra). Confirmar quais representam CT-e cancelado.
RODOPAR_SITUACOES_VALIDAS=

ANTHROPIC_API_KEY=
JWT_SECRET=trocar-esta-chave
